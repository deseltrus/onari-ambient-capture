# Copy to .env and fill in. .env is gitignored — never commit it, never post
# keys in the group chat. One private .env per person; rotate after the event.

# --- Create your own (free, per-person) -----------------------------
ROCKETRIDE_API_KEY=
GUILD_API_KEY=

# --- FalkorDB ------------------------------------------------------
# Shared cloud instance: ask the team, sent privately.
# FALKOR_SSL is FALSE for our instance — it speaks plain RESP with auth, and
# connecting with TLS HANGS on the handshake instead of erroring.
# Local fallback: docker run -p 6379:6379 -p 3000:3000 --rm falkordb/falkordb:latest
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_USER=
FALKOR_PASSWORD=
FALKOR_SSL=false
FALKOR_TIMEOUT=10

# Which graph to work in. Sessions make sharing one graph safe, so the whole
# team can sit on `onari`; set your own name only if you want isolation.
ONARI_GRAPH=onari

# --- LaserData -----------------------------------------------------
# Local Laser Stack prints this on ./scripts/up.
LASER_CONNECTION_STRING=iggy:laser@127.0.0.1:8090
LASER_STREAM=onari
LASER_TOPIC_IN=ambient-events
LASER_TOPIC_OUT=dispatch-results

# --- Capture (optional) --------------------------------------------
# ONARI_HOTKEY=ctrl+opt+cmd+n
# ONARI_TRANSCRIBE_CMD=uv run parakeet-mlx-transcribe
